# ============================================================
# .gitignore, Developer Portfolio (static site)
# ============================================================

# ---- Operating system ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# ---- Node / npm (only if a build step is ever added) ----
# Note: lock files (package-lock.json / yarn.lock / pnpm-lock.yaml)
# are intentionally NOT ignored, commit them for reproducible installs.
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Secrets / local env ----
.env
.env.*
*.local

# ---- Logs & temp ----
*.log
logs/
tmp/
.tmp/
.cache/

# ---- Original large uploads ----
# The live site only ever ships the optimized versions; the
# full-resolution originals stay on disk but out of git. They were
# ~99 MB across the backup folders, every byte of that was also
# re-uploaded to the Pages artifact on each deploy.
# The trailing /**/ form matters: a plain `backup/` prefix would miss
# assets/images/projects/{large,og}/backup/.
assets/images/**/backup/
assets/og.png
/github.jpg

# ---- Local-only notes ----
notes.md
